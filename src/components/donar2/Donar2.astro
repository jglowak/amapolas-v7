---
// /donar2: propuesta de rediseño de /donar, de una columna y orientada a conversión.
// Hero con foto → por qué la tierra → impacto → formulario (Mercado Pago con montos + Donorbox
// embebido) → confianza → preguntas frecuentes → cierre. Barra fija "Donar" en mobile.
// La pestaña inicial se elige por país (/api/pais en worker/index.js): Argentina → Mercado Pago.
import { Image } from 'astro:assets';
import plantas from '../../assets/img/plantas.jpg';
import { donar2 } from '../../i18n/donar2';
import { site } from '../../config/site';
import { localePath, type Lang } from '../../i18n/ui';
import DonationForm from '../DonationForm.astro';
import '../../styles/global.css';
import '../../styles/donar2.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = donar2[lang];
const f = c.form;
const L = (p: string) => localePath(lang, p);
const check = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
---
<!-- HERO -->
<section class="d2-hero">
  <Image src={plantas} alt={c.hero.photo} class="d2-hero-img" widths={[768, 1376]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="d2-hero-overlay" aria-hidden="true"></div>
  <div class="d2-hero-body">
    <p class="d2-eyebrow d2-eyebrow--light">{c.hero.eyebrow}</p>
    <h1 class="d2-hero-title">{c.hero.title[0]} <span>{c.hero.title[1]}</span> {c.hero.title[2]}</h1>
    <p class="d2-hero-text">{c.hero.body}</p>
    <a href="#aporte" class="d2-btn d2-btn--big">{c.hero.cta} ↓</a>
    <p class="d2-hero-trust">{c.hero.trust}</p>
  </div>
</section>

<!-- POR QUÉ LA TIERRA -->
<section class="d2-section d2-porque">
  <div class="d2-col reveal">
    <p class="d2-eyebrow">{c.porque.eyebrow}</p>
    <h2 class="d2-title">{c.porque.title}</h2>
    {c.porque.body.map((p) => <p class="d2-lead">{p}</p>)}
    <blockquote class="d2-quote">
      <p>“{c.porque.quote}”</p>
      <cite>{c.porque.quoteAttr}</cite>
    </blockquote>
  </div>
</section>

<!-- IMPACTO -->
<section class="d2-section d2-impacto">
  <div class="d2-col d2-col--wide reveal">
    <p class="d2-eyebrow">{c.impacto.eyebrow}</p>
    <h2 class="d2-title">{c.impacto.title}</h2>
    <div class="d2-impact-grid">
      {c.impacto.items.map(([a, t]) => <div class="d2-impact"><strong>{a}</strong><p>{t}</p></div>)}
    </div>
  </div>
</section>

<!-- FORMULARIO -->
<section class="d2-section d2-form-section" id="aporte">
  <div class="d2-col">
    <p class="d2-eyebrow d2-eyebrow--dark">{f.eyebrow}</p>
    <h2 class="d2-title">{f.title}</h2>
    <DonationForm lang={lang} />
  </div>
</section>

<!-- CONFIANZA -->
<section class="d2-section d2-confianza">
  <div class="d2-col d2-col--wide reveal">
    <p class="d2-eyebrow">{c.confianza.eyebrow}</p>
    <h2 class="d2-title">{c.confianza.title}</h2>
    <ul class="d2-trust-grid">
      {c.confianza.items.map(([h, p]) => <li><span class="d2-check" set:html={check} /><div><h3>{h}</h3><p>{p}</p></div></li>)}
    </ul>
    <a class="d2-link" href={`mailto:${site.email}?subject=${encodeURIComponent(c.confianza.balanceSubject)}`}>{c.confianza.balance} →</a>
  </div>
</section>

<!-- PREGUNTAS FRECUENTES -->
<section class="d2-section d2-faq">
  <div class="d2-col reveal">
    <h2 class="d2-title">{c.faq.eyebrow}</h2>
    {c.faq.items.map(([q, a], i) => (
      <details open={i === 0}>
        <summary>{q}</summary>
        <p>{i === c.faq.items.length - 1 ? <>{a} <a href={L('/comunidad')}>{lang === 'es' ? 'Ver Comunidad' : 'Visit Community'}</a></> : a}</p>
      </details>
    ))}
  </div>
</section>

<!-- CIERRE -->
<section class="d2-final">
  <div class="d2-col">
    <p class="d2-final-title">{c.final.title}</p>
    <a href="#aporte" class="d2-btn d2-btn--big">{c.final.cta}</a>
    <a href={L('/comunidad')} class="d2-final-link">{c.final.other}</a>
  </div>
</section>

<!-- Barra fija en mobile (se oculta cuando el formulario está a la vista) -->
<a href="#aporte" class="d2-sticky" id="d2-sticky">{c.sticky}</a>

<script is:inline>
(function () {
  // Barra fija: visible después del hero y mientras el formulario no está en pantalla
  const sticky = document.getElementById('d2-sticky');
  const form = document.getElementById('aporte');
  const hero = document.querySelector('.d2-hero');
  let formVisible = false, heroVisible = true;
  const update = () => sticky.classList.toggle('on', !formVisible && !heroVisible);
  new IntersectionObserver((e) => { formVisible = e[0].isIntersecting; update(); }).observe(form);
  new IntersectionObserver((e) => { heroVisible = e[0].isIntersecting; update(); }).observe(hero);
})();
</script>
