---
// Copia literal del <footer> de v5 (index.html). Cambian los ítems según el documento
// de correcciones; los datos de contacto y redes salen de src/config/site.ts.
// Los <h5> de columna pasan a <h2 class="foot-h"> (mismo estilo) para no saltar niveles de título.
import { Image } from 'astro:assets';
import logo from '../assets/img/logo_amapolas.png';
import { site } from '../config/site';
import { ui, localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].footer;
const L = (p: string) => localePath(lang, p);
const year = new Date().getFullYear();
---
<!-- FOOTER -->
<footer>
  <div class="footer-top">
    <div>
      <Image src={logo} alt={ui[lang].logoAlt} height={30} densities={[1, 2]} class="foot-logo" />
      <p class="foot-desc">{t.desc}</p>
    </div>
    <div class="foot-col">
      <h2 class="foot-h">{t.coop}</h2>
      <ul>
        <li><a href={L('/nosotras')}>{t.quienes}</a></li>
        <li><a href={L('/proyectos')}>{t.proyectos}</a></li>
        <li><a href={L('/prensa')}>{t.prensa}</a></li>
        <li><a href={L('/comunidad')}>{t.comunidad}</a></li>
      </ul>
    </div>
    <div class="foot-col">
      <h2 class="foot-h">{t.colaborar}</h2>
      <ul>
        <li><a href={L('/donar')}>{t.donar}</a></li>
        <li><a href={L('/comunidad#fundaciones')}>{t.alianzas}</a></li>
        <li><a href={L('/prensa#kit')}>{t.kit}</a></li>
      </ul>
    </div>
    <div class="foot-col">
      <h2 class="foot-h">{t.contacto}</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {year} {t.legal}</p>
    <div class="foot-social">
      <a href={site.social.whatsapp} target="_blank" rel="noopener" title="WhatsApp" aria-label="WhatsApp">wa</a>
      <a href={site.social.linkedin} target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn">in</a>
      <a href={site.social.instagram} target="_blank" rel="noopener" title="Instagram" aria-label="Instagram">ig</a>
      <a href={site.social.facebook} target="_blank" rel="noopener" title="Facebook" aria-label="Facebook">fb</a>
    </div>
  </div>
</footer>
