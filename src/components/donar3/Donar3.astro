---
// /donar3: landing de donación con el registro visual del sitio (v5). El formulario de una columna
// queda a la vista apenas se entra (es el destino de los botones "Donar"); abajo se refuerza el
// mensaje: "Tu aporte importa", por qué confiar y preguntas frecuentes.
import DonationForm from '../DonationForm.astro';
import { donar3 } from '../../i18n/donar3';
import { donar2 } from '../../i18n/donar2';
import { donar } from '../../i18n/donar';
import { site } from '../../config/site';
import { localePath, type Lang } from '../../i18n/ui';
import '../../styles/global.css';
import '../../styles/donar3.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = donar3[lang];
const d2 = donar2[lang];
const left = donar[lang].left;
const L = (p: string) => localePath(lang, p);
---
<!-- ENCABEZADO + FORMULARIO (a la vista al entrar) -->
<section class="d3-top" id="aporte">
  <div class="d3-head">
    <p class="d3-label">{c.head.label}</p>
    <h1>{c.head.title}</h1>
    <p>{c.head.body}</p>
  </div>
  <div class="d3-form">
    <DonationForm lang={lang} />
  </div>
</section>

<!-- TU APORTE IMPORTA -->
<section class="d3-section">
  <div class="d3-col reveal">
    <p class="section-eyebrow">{left.eyebrow}</p>
    <h2 class="section-title">{left.title[0]}<br>{left.title[1]}</h2>
    {left.body.map((p) => <p class="d3-body">{p}</p>)}
    <div class="d3-impacts">
      {left.impacts.map(([a, t]) => <div class="d3-impact"><strong>{a}</strong><span>{t}</span></div>)}
    </div>
    <p class="d3-closing">{left.closing}</p>
  </div>
</section>

<!-- POR QUÉ CONFIAR (formato "pilares" de la home) -->
<section class="d3-section d3-section--white">
  <div class="d3-col reveal">
    <p class="section-eyebrow">{d2.confianza.eyebrow}</p>
    <h2 class="section-title">{d2.confianza.title}</h2>
    <div class="d3-pillars">
      {d2.confianza.items.map(([h, p], i) => (
        <div class="d3-pillar">
          <span class="d3-num">{String(i + 1).padStart(2, '0')}</span>
          <div><h3>{h}</h3><p>{p}</p></div>
        </div>
      ))}
    </div>
    <a class="d3-link" href={`mailto:${site.email}?subject=${encodeURIComponent(d2.confianza.balanceSubject)}`}>{d2.confianza.balance} →</a>
  </div>
</section>

<!-- PREGUNTAS FRECUENTES -->
<section class="d3-section">
  <div class="d3-col reveal">
    <p class="section-eyebrow">{d2.faq.eyebrow}</p>
    {d2.faq.items.map(([q, a], i) => (
      <details class="d3-faq" open={i === 0}>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))}
    <a href="#aporte" class="d3-back">{lang === 'es' ? '↑ Volver al formulario' : '↑ Back to the form'}</a>
  </div>
</section>

<!-- OTRAS FORMAS (diseño de NEWSLETTER de v5, como /donar) -->
<div class="newsletter reveal">
  <h2 class="d3-otras">{c.otras.text}</h2>
  <a href={L('/comunidad')} class="prensa-cta">{c.otras.link}</a>
</div>
