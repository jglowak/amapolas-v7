---
// /donar: landing de donación con el registro visual del sitio (v5). El formulario de una columna
// queda a la vista apenas se entra (es el destino de los botones "Donar"); abajo se refuerza el
// mensaje: "Tu aporte importa", por qué confiar (con popup para pedir el balance), una franja con
// foto y preguntas frecuentes.
import { Image } from 'astro:assets';
import plantas from '../../assets/img/plantas.jpg';
import DonationForm from '../DonationForm.astro';
import FormScript from '../FormScript.astro';
import { donar3 } from '../../i18n/donar3';
import { donar2 } from '../../i18n/donar2';
import { donar } from '../../i18n/donar';
import { site } from '../../config/site';
import { localePath, type Lang } from '../../i18n/ui';
import '../../styles/global.css';
import '../../styles/donar3.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = donar3[lang];
const d2 = donar2[lang];
const left = donar[lang].left;
const L = (p: string) => localePath(lang, p);
const bf = c.balance;
---
<!-- ENCABEZADO + FORMULARIO (a la vista al entrar) -->
<section class="d3-top" id="aporte">
  <div class="d3-head">
    <p class="d3-label">{c.head.label}</p>
    <h1>{c.head.title}</h1>
    <p>{c.head.body}</p>
  </div>
  <div class="d3-form">
    <DonationForm lang={lang} />
  </div>
</section>

<!-- TU APORTE IMPORTA -->
<section class="d3-section">
  <div class="d3-col reveal">
    <p class="section-eyebrow">{left.eyebrow}</p>
    <h2 class="section-title">{left.title[0]}<br>{left.title[1]}</h2>
    {left.body.map((p) => <p class="d3-body">{p}</p>)}
    <div class="d3-impacts">
      {left.impacts.map(([a, t]) => <div class="d3-impact"><strong>{a}</strong><span>{t}</span></div>)}
    </div>
    <p class="d3-closing">{left.closing}</p>
  </div>
</section>

<!-- POR QUÉ CONFIAR (formato "pilares" de la home) -->
<section class="d3-section d3-section--white">
  <div class="d3-col reveal">
    <p class="section-eyebrow">{d2.confianza.eyebrow}</p>
    <h2 class="section-title">{d2.confianza.title}</h2>
    <div class="d3-pillars">
      {d2.confianza.items.map(([h, p], i) => (
        <div class="d3-pillar">
          <span class="d3-num">{String(i + 1).padStart(2, '0')}</span>
          <div><h3>{h}</h3><p>{p}</p></div>
        </div>
      ))}
    </div>
    <button type="button" class="d3-link" id="d3-balance-open" aria-haspopup="dialog" aria-controls="d3-balance">{d2.confianza.balance} →</button>
  </div>
</section>

<!-- FRANJA CON FOTO -->
<section class="d3-image">
  <Image src={plantas} alt={c.imagen.alt} class="d3-image-bg" widths={[768, 1376]} sizes="100vw" loading="lazy" />
  <div class="d3-image-overlay" aria-hidden="true"></div>
  <div class="d3-image-body reveal">
    <p class="d3-image-quote">“{c.imagen.quote}”</p>
    <p class="d3-image-attr">{c.imagen.attr}</p>
    <a href="#aporte" class="d3-image-cta">{c.imagen.cta}</a>
  </div>
</section>

<!-- PREGUNTAS FRECUENTES -->
<section class="d3-section">
  <div class="d3-col reveal">
    <p class="section-eyebrow">{d2.faq.eyebrow}</p>
    {d2.faq.items.map(([q, a], i) => (
      <details class="d3-faq" open={i === 0}>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))}
    <a href="#aporte" class="d3-back">{lang === 'es' ? '↑ Volver al formulario' : '↑ Back to the form'}</a>
  </div>
</section>

<!-- OTRAS FORMAS (diseño de NEWSLETTER de v5, como /donar) -->
<div class="newsletter reveal">
  <h2 class="d3-otras">{c.otras.text}</h2>
  <a href={L('/comunidad')} class="prensa-cta">{c.otras.link}</a>
</div>

<!-- POPUP: pedido de balance (envía a /api/contacto, form "balance") -->
<dialog class="d3-modal" id="d3-balance" aria-labelledby="d3-balance-title">
  <button type="button" class="d3-modal-close" data-close aria-label={bf.close}>×</button>
  <h2 id="d3-balance-title">{bf.title}</h2>
  <p class="d3-modal-intro">{bf.intro}</p>
  <form id="balanceForm" method="POST" data-form="balance" data-endpoint={site.forms.balance} data-subject={bf.subject} onsubmit="amapolasSubmit(event,'balanceSuccess')">
    <label class="d3-label-f" for="b_nombre">{bf.nombre}</label>
    <input class="d3-input" type="text" id="b_nombre" name="nombre" placeholder={bf.nombrePh} required autocomplete="name">
    <label class="d3-label-f" for="b_org">{bf.org}</label>
    <input class="d3-input" type="text" id="b_org" name="organizacion" placeholder={bf.orgPh} autocomplete="organization">
    <label class="d3-label-f" for="b_email">{bf.email}</label>
    <input class="d3-input" type="email" id="b_email" name="email" placeholder={bf.emailPh} required autocomplete="email">
    <label class="d3-label-f" for="b_msg">{bf.mensaje}</label>
    <textarea class="d3-input d3-textarea" id="b_msg" name="mensaje" placeholder={bf.mensajePh}></textarea>
    {site.forms.turnstileSiteKey && <div class="turnstile-wrap"><div class="cf-turnstile" data-sitekey={site.forms.turnstileSiteKey} data-theme="light" data-language={lang}></div></div>}
    <button type="submit" class="d3-submit">{bf.enviar}</button>
  </form>
  <div class="d3-success" id="balanceSuccess" role="status"><h3>{bf.ok[0]}</h3><p>{bf.ok[1]}</p></div>
</dialog>

<FormScript lang={lang} />
<script is:inline>
(function () {
  const dlg = document.getElementById('d3-balance');
  document.getElementById('d3-balance-open').addEventListener('click', () => dlg.showModal());
  dlg.querySelector('[data-close]').addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
})();
</script>
