---
// Acciones y Prensa. Markup extraído de v5 prensa.html (scripts/v5-extract/prensa/body.html).
// CSS: pages/prensa.css completo. Cambios del documento: hero con texto nuevo y sin números;
// orden Eventos → Prensa → Contacto → Kit; eventos 2023–2026 actualizados (fondos internacionales,
// HIC, ONU Mujeres, links de YouTube); contacto sin "48 hs"; kit y boilerplate nuevos; mail único.
import { prensa } from '../../i18n/prensa';
import { site } from '../../config/site';
import { localePath, type Lang } from '../../i18n/ui';
import FormScript from '../FormScript.astro';
import '../../styles/pages/prensa.css';
import '../../styles/prensa-v7.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = prensa[lang];
const L = (p: string) => localePath(lang, p);
const typeIcon = {
  radio: '<circle cx="12" cy="12" r="2"></circle><path d="M16.24 7.76a6 6 0 010 8.49m-8.48-.01a6 6 0 010-8.49m11.31-2.82a10 10 0 010 14.14m-14.14 0a10 10 0 010-14.14"></path>',
  nota: '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline>',
  video: '<polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>',
};
const kitIcons = [
  '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline>',
  '<rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path>',
  '<circle cx="12" cy="12" r="10"></circle><path d="M8 12l2 2 4-4"></path>',
  '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line>',
];
const mailIcon = '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline>';
const f = c.contacto.form;
---
<!-- HERO (sin números) -->
<div class="hero" id="hero">
  <div class="hero-body">
    <div class="hero-breadcrumb" role="navigation" aria-label={lang === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}>
      <a href={L('/')}>{c.hero.home}</a><span>/</span>
      <span style="color:rgba(255,255,255,.6)" aria-current="page">{c.hero.here}</span>
    </div>
    <h1 class="hero-title">{c.hero.title[0]}<br>{c.hero.title[1]}</h1>
    <p class="hero-subtitle">{c.hero.subtitle}</p>
  </div>
  <div class="hero-tabs">
    {c.hero.tabs.map(([href, t]) => <a href={href} class="hero-tab">{t}</a>)}
  </div>
</div>

<!-- EVENTOS Y ACCIONES -->
<section class="timeline-section" id="eventos">
  <div class="timeline-inner">
    <p class="section-eyebrow rojo reveal">{c.eventos.eyebrow}</p>
    <h2 class="section-title reveal">{c.eventos.title}</h2>
    {c.eventos.years.map(([year, evs]) => (
      <div class="year-block reveal">
        <div class="year-label">{year}</div>
        <div class="events-list">
          {evs.map((e) => (
            <div class:list={['event-item', e.hito && 'destacado hito-alto']}>
              <div class="event-body">
                <p class:list={['event-tag', e.tc]}>{e.tag}</p>
                <h3 class="event-title">{e.h}</h3>
                <p class="event-desc">{e.p}</p>
                {e.links && <div class="event-links">{e.links.map(([t, href]) => <a href={href} target="_blank" rel="noopener" class="event-link">{t}</a>)}</div>}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- PRENSA (MEDIOS) -->
<section class="prensa-dest" id="prensa">
  <div class="prensa-dest-inner">
    <p class="section-eyebrow rojo reveal">{c.medios.eyebrow}</p>
    <h2 class="section-title reveal">{c.medios.title}</h2>
    <div class="medios-grid reveal">
      {c.medios.items.map((m) => (
        <div class="medio-card">
          <span class="medio-source">{m.s}</span>
          <p class="medio-title">{m.h}</p>
          <p class="medio-desc">{m.p}</p>
          <span class="medio-type">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={typeIcon[m.type]} />
            {m.tl}
          </span>
          <a href={m.href} target="_blank" rel="noopener" class="medio-link">{m.cta}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CONTACTO PRENSA -->
<section class="contacto-prensa" id="contacto-prensa">
  <div class="contacto-prensa-inner">
    <div class="reveal">
      <p class="section-eyebrow">{c.contacto.eyebrow}</p>
      <h2 class="section-title">{c.contacto.title[0]}<br>{c.contacto.title[1]}<br>{c.contacto.title[2]}</h2>
      <p class="cp-desc">{c.contacto.desc}</p>
      <div class="cp-info">
        <div class="cp-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          {c.contacto.persona}
        </div>
        <div class="cp-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={mailIcon} />
          <a href={`mailto:${site.email}`} style="color:inherit">{site.email}</a>
        </div>
        <div class="cp-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          {c.contacto.lugar}
        </div>
      </div>
    </div>

    <div class="form-card reveal">
      <!-- TODO: endpoint en src/config/site.ts (forms.prensa); sin endpoint abre el correo -->
      <form id="prensaForm" method="POST" data-endpoint={site.forms.prensa} data-subject={f.subject} onsubmit="amapolasSubmit(event,'prensaSuccess')">
        <div class="form-row-2">
          <div>
            <label class="form-label" for="p_nombre">{f.nombre}</label>
            <input class="form-input" type="text" id="p_nombre" name="nombre" placeholder={f.nombrePh} required autocomplete="name">
          </div>
          <div>
            <label class="form-label" for="p_medio">{f.medio}</label>
            <input class="form-input" type="text" id="p_medio" name="medio" placeholder={f.medioPh} required autocomplete="organization">
          </div>
        </div>
        <div class="form-row">
          <label class="form-label" for="p_email">{f.email}</label>
          <input class="form-input" type="email" id="p_email" name="email" placeholder={f.emailPh} required autocomplete="email">
        </div>
        <div class="form-row">
          <label class="form-label" for="p_mensaje">{f.consulta}</label>
          <textarea class="form-textarea" id="p_mensaje" name="mensaje" placeholder={f.consultaPh} required></textarea>
        </div>
        {site.forms.turnstileSiteKey && <div class="turnstile-wrap"><div class="cf-turnstile" data-sitekey={site.forms.turnstileSiteKey} data-theme="light" data-language={lang}></div></div>}
        <button type="submit" class="btn-submit" id="prensaBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          {f.enviar}
        </button>
      </form>
      <div class="form-success" id="prensaSuccess">
        <h3>{c.contacto.ok[0]}</h3>
        <p>{c.contacto.ok[1]}</p>
      </div>
    </div>
  </div>
</section>

<!-- KIT DE PRENSA -->
<section class="kit-section" id="kit">
  <div class="kit-inner">
    <div class="kit-header">
      <div class="kit-header-text">
        <p class="section-eyebrow">{c.kit.eyebrow}</p>
        <h2 class="section-title" style="color:white">{c.kit.title}</h2>
        <p>{c.kit.body}</p>
      </div>
      <div class="kit-contacto reveal">
        <p class="kit-contacto-label">{c.kit.contactoLabel}</p>
        <div class="kit-contacto-card">
          <p class="kit-contacto-nombre">{c.kit.contactoNombre}</p>
          <p class="kit-contacto-cargo">{c.kit.contactoCargo}</p>
          <a href={`mailto:${site.email}`} class="kit-contacto-email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={mailIcon} />
            {site.email}
          </a>
        </div>
      </div>
    </div>

    <div class="kit-materiales-grid reveal">
      {c.kit.materiales.map((m, i) => (
        <div class="kit-material">
          <div class="kit-material-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={kitIcons[i]} />
          </div>
          <p class="kit-material-tag">{m.tag}</p>
          <h3 class="kit-material-title">{m.h}</h3>
          <p class="kit-material-desc">{m.p}</p>
          {/* TODO: archivos del kit pendientes */}
          <div style="display:flex;gap:.5rem;flex-direction:column">
            {m.links.map(([t, href]) => <a href={href} target="_blank" rel="noopener" class="kit-material-link">{t}</a>)}
          </div>
        </div>
      ))}
    </div>

    <div class="kit-boilerplate reveal">
      <p class="kit-boilerplate-label">{c.kit.boilerLabel}</p>
      <p class="kit-boilerplate-text">{c.kit.boiler}</p>
    </div>
  </div>
</section>

<FormScript lang={lang} />
