---
import Base from '../layouts/Base.astro';
import Privacidad from '../components/legal/Privacidad.astro';
import { privacidad } from '../i18n/privacidad';
const { title, description, crumb } = privacidad.es.meta;
---
<Base lang="es" title={title} description={description} breadcrumbs={[{ name: crumb, path: '/privacidad' }]}>
  <Privacidad lang="es" />
</Base>
