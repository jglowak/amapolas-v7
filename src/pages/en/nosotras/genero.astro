---
import Base from '../../../layouts/Base.astro';
import Genero from '../../../components/nosotras/Genero.astro';
import { genero } from '../../../i18n/genero';
import { nosotras } from '../../../i18n/nosotras';
const { title, description, crumb } = genero.en.meta;
---
<Base lang="en" title={title} description={description} breadcrumbs={[{ name: nosotras.en.meta.crumb, path: '/nosotras' }, { name: crumb, path: '/nosotras/genero' }]}>
  <Genero lang="en" />
</Base>
