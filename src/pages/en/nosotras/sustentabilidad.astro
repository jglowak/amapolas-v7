---
import Base from '../../../layouts/Base.astro';
import Sustentabilidad from '../../../components/nosotras/Sustentabilidad.astro';
import { sustentabilidad } from '../../../i18n/sustentabilidad';
import { nosotras } from '../../../i18n/nosotras';
const { title, description, crumb } = sustentabilidad.en.meta;
---
<Base lang="en" title={title} description={description} breadcrumbs={[{ name: nosotras.en.meta.crumb, path: '/nosotras' }, { name: crumb, path: '/nosotras/sustentabilidad' }]}>
  <Sustentabilidad lang="en" />
</Base>
