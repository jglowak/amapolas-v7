---
import Base from '../../../layouts/Base.astro';
import Formacion from '../../../components/proyectos/Formacion.astro';
import { formacion } from '../../../i18n/formacion';
import { proyectos } from '../../../i18n/proyectos';
const { title, description, crumb } = formacion.en.meta;
---
<Base lang="en" title={title} description={description} breadcrumbs={[{ name: proyectos.en.meta.crumb, path: '/proyectos' }, { name: crumb, path: '/proyectos/formacion' }]}>
  <Formacion lang="en" />
</Base>
