---
import Base from '../layouts/Base.astro';
import Proyectos from '../components/proyectos/Proyectos.astro';
import { proyectos } from '../i18n/proyectos';

const { title, description, crumb } = proyectos.es.meta;
---
<Base lang="es" title={title} description={description} breadcrumbs={[{ name: crumb, path: '/proyectos' }]}>
  <Proyectos lang="es" />
</Base>
