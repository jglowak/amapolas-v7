---
import Base from '../layouts/Base.astro';
import Donar3 from '../components/donar3/Donar3.astro';
import { donar3 } from '../i18n/donar3';
import { site } from '../config/site';
const { title, description, crumb } = donar3.es.meta;
const donate = { '@type': 'DonateAction', name: title, recipient: { '@id': `${site.url}/#organization` }, ...(site.verified.donate ? { target: [site.donate.donorbox, site.donate.mercadoPago] } : {}) };
---
<Base lang="es" title={title} description={description} breadcrumbs={[{ name: crumb, path: '/donar' }]} graph={[donate]}>
  <Donar3 lang="es" />
</Base>
