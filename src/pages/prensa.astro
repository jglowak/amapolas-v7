---
import Base from '../layouts/Base.astro';
import Prensa from '../components/prensa/Prensa.astro';
import { prensa } from '../i18n/prensa';

const { title, description, crumb } = prensa.es.meta;
---
<Base lang="es" title={title} description={description} breadcrumbs={[{ name: crumb, path: '/prensa' }]}>
  <Prensa lang="es" />
</Base>
