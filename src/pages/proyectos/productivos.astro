---
import Base from '../../layouts/Base.astro';
import Productivos from '../../components/proyectos/Productivos.astro';
import { productivos } from '../../i18n/productivos';
import { proyectos } from '../../i18n/proyectos';
const { title, description, crumb } = productivos.es.meta;
---
<Base lang="es" title={title} description={description} breadcrumbs={[{ name: proyectos.es.meta.crumb, path: '/proyectos' }, { name: crumb, path: '/proyectos/productivos' }]}>
  <Productivos lang="es" />
</Base>
