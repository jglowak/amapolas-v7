---
// Página 404 (Cloudflare: not_found_handling "404-page"). Diseño del bloque dossier de v5.
import Base from '../layouts/Base.astro';
import '../styles/global.css';
import '../styles/donar-v7.css';
---
<Base lang="es" title="Página no encontrada · Amapolas" description="La página que buscás no existe o cambió de dirección.">
  <div class="dossier-section donar-head">
    <div class="dossier-inner">
      <div class="dossier-text">
        <p class="label">Error 404 · Page not found</p>
        <h1>Página no encontrada</h1>
        <p>La página que buscás no existe o cambió de dirección. · The page you are looking for does not exist.</p>
      </div>
      <div class="dossier-btns">
        <a href="/" class="btn-dossier es">Ir al inicio →</a>
        <a href="/en" class="btn-dossier en" hreflang="en">Go to home (EN) →</a>
      </div>
    </div>
  </div>
</Base>
