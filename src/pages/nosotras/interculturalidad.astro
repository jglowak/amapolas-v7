---
import Base from '../../layouts/Base.astro';
import Interculturalidad from '../../components/nosotras/Interculturalidad.astro';
import { interculturalidad } from '../../i18n/interculturalidad';
import { nosotras } from '../../i18n/nosotras';
const { title, description, crumb } = interculturalidad.es.meta;
---
<Base lang="es" title={title} description={description} breadcrumbs={[{ name: nosotras.es.meta.crumb, path: '/nosotras' }, { name: crumb, path: '/nosotras/interculturalidad' }]}>
  <Interculturalidad lang="es" />
</Base>
