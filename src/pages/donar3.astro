---
// Propuesta de landing de donación (borrador: fuera de buscadores y del sitemap).
import Base from '../layouts/Base.astro';
import Donar3 from '../components/donar3/Donar3.astro';
import { donar3 } from '../i18n/donar3';
const { title, description, crumb } = donar3.es.meta;
---
<Base lang="es" title={title} description={description} breadcrumbs={[{ name: crumb, path: '/donar3' }]} noindex>
  <Donar3 lang="es" />
</Base>
