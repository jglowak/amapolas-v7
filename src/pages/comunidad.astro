---
import Base from '../layouts/Base.astro';
import Comunidad from '../components/comunidad/Comunidad.astro';
import { comunidad } from '../i18n/comunidad';
const { title, description, crumb } = comunidad.es.meta;
---
<Base lang="es" title={title} description={description} breadcrumbs={[{ name: crumb, path: '/comunidad' }]} navLight>
  <Comunidad lang="es" />
</Base>
