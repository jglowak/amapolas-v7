// Cloudflare Workers: sitio estático (dist/) + worker/index.js para /api/* (formularios y newsletter con Brevo).
// Build: npm run build → dist/. Secretos en el panel: BREVO_API_KEY (obligatorio), TURNSTILE_SECRET (opcional).
{
  "name": "amapolas-v7",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MAIL_TO": "info@amapolas.org",
    "MAIL_FROM": "info@amapolas.org",
    "BREVO_LIST_ID": "3",
    // Plantillas transaccionales de Brevo (respuesta automática y confirmación de newsletter)
    "BREVO_TPL_REPLY_ES": "1",
    "BREVO_TPL_REPLY_EN": "2",
    "BREVO_TPL_DOI_ES": "3",
    "BREVO_TPL_DOI_EN": "4"
  },
  // Lunes 9:17 UTC: mantiene activa la clave de Brevo (worker/index.js → scheduled)
  "triggers": { "crons": ["17 9 * * 1"] },
  "observability": { "enabled": true }
}
